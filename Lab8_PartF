struct EnvRecord {
  float tempC;
  float humPct;
  float presHpa;
  float lux;
  uint8_t flags;
};

unsigned long lastAcquireTime = 0;
const unsigned long acquireInterval = 5000; 
bool toggleDisplay = false; 
bool sdMounted = false;

// Reconnection with backoff variables
unsigned long nextRetry = 0;
unsigned long backoff = 1000;

const char* logFilename = "/env_log.csv";

// Function Prototypes
EnvRecord acquireData();
uint8_t checkPlausibility(const EnvRecord& r);
void updateLCD(const EnvRecord& r);
void logToSD(const EnvRecord& r);
void maintainLink();
void handleSerialCommands();
bool initSDCard();
void ejectSDCard();
void readSDFile();
void listSDFiles();

void startClock() {
  configTime(8 * 3600, 0, "pool.ntp.org", "time.nist.gov");
  time_t now = time(nullptr);
  unsigned long startWait = millis();
  while (now < 1700000000 && millis() - startWait < 5000) {
    delay(300);
    now = time(nullptr);
  }
}

String buildPayload(const EnvRecord& r) {
  StaticJsonDocument<256> doc;
  doc["deviceId"] = DEVICE_ID;
  doc["ts"]       = (long)time(nullptr);
  doc["tempC"]    = r.tempC;
  doc["humPct"]   = r.humPct;
  doc["presHpa"]  = r.presHpa;
  doc["lux"]      = r.lux;
  doc["flags"]    = r.flags;

  String out;
  serializeJson(doc, out);
  return out;
}

bool putJson(const String& path, const String& body) {
  if (WiFi.status() != WL_CONNECTED) return false;
  
  HTTPClient http;
  String url = String(DB_BASE) + path + ".json?auth=" + String(DB_TOKEN);
  http.begin(url);
  http.addHeader("Content-Type", "application/json");
  int code = http.PUT(body);
  http.end();
  return (code == 200);
}

void publishRegistry() {
  StaticJsonDocument<256> doc;
  doc["deviceId"] = DEVICE_ID;
  doc["location"] = "Lab Station A";
  doc["tempUnit"] = "degC";
  doc["humUnit"]  = "pct";
  doc["presUnit"] = "hPa";
  doc["luxUnit"]  = "lx";

  String body;
  serializeJson(doc, body);
  putJson("/devices/" + String(DEVICE_ID) + "/registry", body);
}

void publish(const EnvRecord& r) {
  if (WiFi.status() != WL_CONNECTED) return;
  String body = buildPayload(r);
  long ts = (long)time(nullptr);
  
  putJson("/devices/" + String(DEVICE_ID) + "/current", body);
  putJson("/devices/" + String(DEVICE_ID) + "/history/" + String(ts), body);
}

void maintainLink() {
  if (WiFi.status() == WL_CONNECTED) {
    backoff = 1000;
    return;
  }

  if (millis() >= nextRetry) {
    WiFi.disconnect();
    WiFi.begin(ssid, pass);
    nextRetry = millis() + backoff;
    backoff = min(backoff * 2, 60000UL); // cap at 1 minute
  }
}

bool initSDCard() {
  Serial.println("\n[SD DIAG] Initializing SPI bus (SCK=18, MISO=19, MOSI=23, CS=5)...");
  SPI.begin(18, 19, 23, SD_CS_PIN);

  if (SD.begin(SD_CS_PIN)) {
    sdMounted = true;
    Serial.println("[SD DIAG] SUCCESS: MicroSD Card Mounted!");

    if (!SD.exists(logFilename)) {
      Serial.println("[SD DIAG] File /env_log.csv does not exist. Creating header...");
      File file = SD.open(logFilename, FILE_WRITE);
      if (file) {
        file.println("Timestamp_s,Temp_C,Hum_Pct,Pres_hPa,Lux,Flags");
        file.flush();
        file.close();
        Serial.println("[SD DIAG] Header written successfully!");
      }
    } else {
      Serial.println("[SD DIAG] File /env_log.csv loaded.");
    }
    return true;
  } else {
    sdMounted = false;
    Serial.println("[SD DIAG] ERROR: SD.begin() failed!");
    return false;
  }
}

void ejectSDCard() {
  if (!sdMounted) {
    Serial.println("[SD DIAG] Card is already unmounted or not present.");
    return;
  }

  Serial.println("\n[SD EJECT] Flushing buffers and closing filesystem...");
  SD.end(); // Safely unmount SD SPI peripheral
  sdMounted = false;

  Serial.println("=================================================");
  Serial.println("  SAFE TO REMOVE MICROSD CARD NOW!");
  Serial.println("  Re-insert card and type 'init' or '1' to remount.");
  Serial.println("=================================================\n");

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("SAFE TO REMOVE");
  lcd.setCursor(0, 1);
  lcd.print("SD CARD EJECTED");
}

void readSDFile() {
  if (!sdMounted) {
    Serial.println("[SD DIAG] Cannot read: SD card is not mounted!");
    return;
  }

  File file = SD.open(logFilename, FILE_READ);
  if (file) {
    Serial.println("\n--- BEGIN /env_log.csv CONTENTS ---");
    while (file.available()) {
      Serial.write(file.read());
    }
    file.close();
    Serial.println("--- END /env_log.csv CONTENTS ---\n");
  } else {
    Serial.println("[SD DIAG] ERROR: Could not open /env_log.csv for reading.");
  }
}

void listSDFiles() {
  if (!sdMounted) {
    Serial.println("[SD DIAG] Cannot list files: SD card is not mounted!");
    return;
  }

  File root = SD.open("/");
  Serial.println("\n--- ROOT DIRECTORY FILES ---");
  while (true) {
    File entry = root.openNextFile();
    if (!entry) break;
    Serial.print(entry.name());
    if (entry.isDirectory()) {
      Serial.println("/");
    } else {
      Serial.printf(" \t\t SIZE: %d bytes\n", entry.size());
    }
    entry.close();
  }
  root.close();
  Serial.println("----------------------------\n");
}

void handleSerialCommands() {
  if (Serial.available() > 0) {
    String cmd = Serial.readStringUntil('\n');
    cmd.trim();

    if (cmd == "1" || cmd == "init") {
      initSDCard();
    } else if (cmd == "2" || cmd == "write") {
      EnvRecord dummy = acquireData();
      logToSD(dummy);
    } else if (cmd == "3" || cmd == "read") {
      readSDFile();
    } else if (cmd == "4" || cmd == "list") {
      listSDFiles();
    } else if (cmd == "5" || cmd == "eject") {
      ejectSDCard();
    } else {
      Serial.println("\n--- AVAILABLE DIAGNOSTIC COMMANDS ---");
      Serial.println("Type '1' or 'init'  : Mount/Re-initialize SD Card");
      Serial.println("Type '2' or 'write' : Force manual sample write");
      Serial.println("Type '3' or 'read'  : View log file contents");
      Serial.println("Type '4' or 'list'  : List files on card");
      Serial.println("Type '5' or 'eject' : SAFE EJECT SD card before removal");
      Serial.println("-------------------------------------\n");
    }
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  // 1. Initialize MicroSD Card
  initSDCard();

  // 2. Initialize I2C Bus & Peripherals
  Wire.begin(21, 22);

  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Lab 8 System A");
  lcd.setCursor(0, 1);
  lcd.print("Initializing...");

  dht.begin();
  bmpA.begin(BMP_A_ADDR);
  bmpA.setSampling(Adafruit_BMP280::MODE_NORMAL, Adafruit_BMP280::SAMPLING_X2, Adafruit_BMP280::SAMPLING_X16, Adafruit_BMP280::FILTER_X16, Adafruit_BMP280::STANDBY_MS_500);
  lightMeter.begin(BH1750::CONTINUOUS_HIGH_RES_MODE);

  // 3. Initialize Wi-Fi & NTP Time
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, pass);
  startClock();
  if (WiFi.status() == WL_CONNECTED) {
    publishRegistry();
  }
  lcd.clear();
}

void loop() {
  handleSerialCommands();
  maintainLink();

  unsigned long now = millis();

  if (now - lastAcquireTime >= acquireInterval) {
    lastAcquireTime = now;

    EnvRecord record = acquireData();

    if (sdMounted) {
      logToSD(record);
    }

    publish(record);

    String jsonPayload = buildPayload(record);
    Serial.println(jsonPayload);

    updateLCD(record);
  }
}

EnvRecord acquireData() {
  EnvRecord r;
  r.tempC   = dht.readTemperature();
  r.humPct  = dht.readHumidity();
  r.presHpa = bmpA.readPressure() / 100.0F; 
  r.lux     = lightMeter.readLightLevel();
  r.flags   = checkPlausibility(r);
  return r;
}

uint8_t checkPlausibility(const EnvRecord& r) {
  uint8_t f = 0x00;
  if (isnan(r.tempC) || r.tempC < -20.0 || r.tempC > 70.0) f |= 0x01;
  if (isnan(r.humPct) || r.humPct < 0.0 || r.humPct > 100.0) f |= 0x02;
  if (isnan(r.presHpa) || r.presHpa < 800.0 || r.presHpa > 1100.0) f |= 0x04;
  if (isnan(r.lux) || r.lux < 0.0 || r.lux > 100000.0) f |= 0x08;
  return f;
}

void logToSD(const EnvRecord& r) {
  File logFile = SD.open(logFilename, FILE_WRITE);
  if (logFile) {
    logFile.printf("%ld,%.1f,%.1f,%.1f,%.1f,0x%02X\n",
                   (long)time(nullptr), r.tempC, r.humPct, r.presHpa, r.lux, r.flags);
    logFile.flush(); 
    logFile.close();
  } else {
    sdMounted = false;
  }
}

void updateLCD(const EnvRecord& r) {
  lcd.clear();

  if (!sdMounted) {
    lcd.setCursor(0, 0);
    lcd.print("SD: UNMOUNTED");
    lcd.setCursor(0, 1);
    lcd.print("SAFE TO REMOVE");
    return;
  }

  if (r.flags != 0x00) {
    lcd.setCursor(0, 0);
    lcd.print("FLAG: 0x");
    if (r.flags < 0x10) lcd.print("0");
    lcd.print(r.flags, HEX);
    lcd.print(" ERR");

    lcd.setCursor(0, 1);
    lcd.print("SD: LOGGING");
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {
    lcd.setCursor(0, 0);
    lcd.print("WiFi DISCONNECT");
    lcd.setCursor(0, 1);
    lcd.print("SD LOGGING OK");
    return;
  }

  if (!toggleDisplay) {
    lcd.setCursor(0, 0);
    lcd.print("T:"); lcd.print(r.tempC, 1); lcd.print("C ");
    lcd.print("H:"); lcd.print((int)r.humPct); lcd.print("%");

    lcd.setCursor(0, 1);
    lcd.print("SD: LOGGING OK");
  } else {
    lcd.setCursor(0, 0);
    lcd.print("P:"); lcd.print(r.presHpa, 1); lcd.print("hPa");

    lcd.setCursor(0, 1);
    lcd.print("L:"); lcd.print(r.lux, 1); lcd.print("lx");
  }

  toggleDisplay = !toggleDisplay;
}
