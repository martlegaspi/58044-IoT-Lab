#include <Wire.h>
#include <Adafruit_BMP280.h>
#include <BH1750.h>
#include <DHT.h>

#define DHT_PIN     4
#define DHT_TYPE    DHT22
#define BH1750_ADDR 0x23
#define BMP_A_ADDR  0x77 // Updated to match your scanner address

Adafruit_BMP280 bmpA;
BH1750          lightMeter(BH1750_ADDR);
DHT             dht(DHT_PIN, DHT_TYPE);

// Structure for a single coherent acquisition snapshot
struct EnvRecord {
  uint32_t ts;       // Timestamp (seconds)
  float tempC;      // Temperature from DHT22 (°C)
  float humPct;     // Relative Humidity from DHT22 (%)
  float presHpa;    // Barometric Pressure from BMP280 (hPa)
  float lux;        // Light level from BH1750 (lux)
};

unsigned long lastAcquireTime = 0;
const unsigned long acquireInterval = 2000; // 2 seconds governed by DHT22

void setup() {
  Serial.begin(115200);
  while (!Serial && millis() < 3000);

  Serial.println("\n=== Lab 7: Single Acquisition Cycle (Part D) ===");

  Wire.begin(21, 22);
  dht.begin();
  
  if (!bmpA.begin(BMP_A_ADDR)) {
    Serial.println("BMP280 Sensor not found!");
  }
  if (!lightMeter.begin(BH1750::CONTINUOUS_HIGH_RES_MODE)) {
    Serial.println("BH1750 Light Sensor not found!");
  }
}

void loop() {
  unsigned long now = millis();

  // Non-blocking timer
  if (now - lastAcquireTime >= acquireInterval) {
    lastAcquireTime = now;

    // Perform synchronized single acquisition cycle
    EnvRecord record = acquireData();

    // Print unified record to Serial
    Serial.printf("[%lu s] Temp: %.1f °C | Hum: %.1f %% | Pres: %.2f hPa | Light: %.1f lux\n",
                  record.ts, record.tempC, record.humPct, record.presHpa, record.lux);
  }
}

EnvRecord acquireData() {
  EnvRecord r;
  r.ts      = millis() / 1000;
  r.tempC   = dht.readTemperature();
  r.humPct  = dht.readHumidity();
  r.presHpa = bmpA.readPressure() / 100.0F; // Convert Pa to hPa
  r.lux     = lightMeter.readLightLevel();
  return r;
}
