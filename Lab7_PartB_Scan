#include <Wire.h>

void setup() {
  Serial.begin(115200);
  while (!Serial && millis() < 3000);

  // Initialize I2C bus on ESP32 SDA (GPIO 21) and SCL (GPIO 22)
  Wire.begin(21, 22);

  Serial.println("\n==================================================");
  Serial.println("  Lab 7 Part B: Post-Conflict I2C Bus Scanner     ");
  Serial.println("==================================================");
}

void loop() {
  byte error, address;
  int nDevices = 0;

  Serial.println("[INFO] Scanning I2C bus for all active devices...");

  for (address = 1; address < 127; address++) {
    Wire.beginTransmission(address);
    error = Wire.endTransmission();

    if (error == 0) {
      Serial.printf(" > Active device found at address 0x%02X -> ", address);

      switch (address) {
        case 0x23:
          Serial.println("BH1750 Ambient Light Sensor");
          break;
        case 0x27:
          Serial.println("16x2 LCD Character Display (PCF8574)");
          break;
        case 0x76:
          Serial.println("BMP280 Sensor #1 (SDO -> GND)");
          break;
        case 0x77:
          Serial.println("BMP280 Sensor #2 (SDO -> 3.3V / Default)");
          break;
        default:
          Serial.println("Unrecognized I2C Peripheral");
          break;
      }
      nDevices++;
    } else if (error == 4) {
      Serial.printf(" ! Unknown bus error at address 0x%02X\n", address);
    }
  }

  if (nDevices == 0) {
    Serial.println("[WARN] No I2C devices detected! Check bus power and SDA/SCL lines.\n");
  } else {
    Serial.printf("[SUCCESS] Scan complete. Total active devices on bus: %d\n\n", nDevices);
  }

  delay(5000); // Repeat scan every 5 seconds
}
