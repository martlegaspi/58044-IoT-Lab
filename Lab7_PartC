#include <SPI.h>
#include <SD.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// --- Pin & Address Definitions ---
#define SD_CS_PIN    5
#define LCD_ADDR     0x27

LiquidCrystal_I2C lcd(LCD_ADDR, 16, 2);

void setup() {
  Serial.begin(115200);
  while (!Serial && millis() < 3000);

  Serial.println("\n=== Lab 7: SPI MicroSD Initialization Test (Part C) ===");

  // Initialize LCD Display
  Wire.begin(21, 22);
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Part C: SPI Test");
  lcd.setCursor(0, 1);
  lcd.print("Mounting SD...");

  // Initialize SPI MicroSD Module
  Serial.print("Initializing SD card on CS Pin ");
  Serial.println(SD_CS_PIN);

  if (!SD.begin(SD_CS_PIN)) {
    Serial.println("[FAIL] SD Card initialization failed or card not present!");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("SD Mount: FAIL");
    lcd.setCursor(0, 1);
    lcd.print("Check Wiring/FAT");
    return;
  }

  Serial.println("[OK] SD Card mounted successfully!");
  
  uint8_t cardType = SD.cardType();
  Serial.print("Card Type: ");
  if (cardType == CARD_MMC) Serial.println("MMC");
  else if (cardType == CARD_SD) Serial.println("SDSC");
  else if (cardType == CARD_SDHC) Serial.println("SDHC");
  else Serial.println("UNKNOWN");

  uint64_t cardSize = SD.cardSize() / (1024 * 1024);
  Serial.printf("Card Size: %llu MB\n", cardSize);

  // File Write/Read Test
  File testFile = SD.open("/test.txt", FILE_WRITE);
  if (testFile) {
    Serial.println("Writing test payload to /test.txt...");
    testFile.println("Lab 7 Part C: SPI File Write Test Successful.");
    testFile.close();
    Serial.println("[OK] File written successfully.");
  } else {
    Serial.println("[FAIL] Could not open /test.txt for writing!");
  }

  // File Verification Read
  testFile = SD.open("/test.txt", FILE_READ);
  if (testFile) {
    Serial.println("Reading contents of /test.txt:");
    while (testFile.available()) {
      Serial.write(testFile.read());
    }
    testFile.close();
  }

  // Update LCD
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("SD Mount: SUCCESS");
  lcd.setCursor(0, 1);
  lcd.printf("Size: %llu MB", cardSize);
}

void loop() {
  // Idle loop for verification test
}
