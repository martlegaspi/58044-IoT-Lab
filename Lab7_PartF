#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <LiquidCrystal_I2C.h>
#include <Adafruit_BMP280.h>
#include <BH1750.h>
#include <DHT.h>

// --- Pin & Address Definitions ---
#define DHT_PIN      4
#define DHT_TYPE     DHT11
#define SD_CS_PIN    5
#define LCD_ADDR     0x27
#define BH1750_ADDR  0x23
#define BMP_A_ADDR   0x77  

// --- Peripheral Instances ---
LiquidCrystal_I2C lcd(LCD_ADDR, 16, 2);
Adafruit_BMP280   bmpA;
BH1750            lightMeter(BH1750_ADDR);
DHT               dht(DHT_PIN, DHT_TYPE);

// --- Data Record Structure ---
struct EnvRecord {
  uint32_t ts;
  float tempC;
  float humPct;
  float presHpa;
  float lux;
  uint8_t flags;
};

unsigned long lastAcquireTime = 0;
const unsigned long acquireInterval = 2000; 
bool toggleDisplay = false; 
bool sdMounted = false;

const char* logFilename = "/env_log.csv";

EnvRecord acquireData();
uint8_t checkPlausibility(const EnvRecord& r);
void updateLCD(const EnvRecord& r);
void logToSD(const EnvRecord& r);

void setup() {
  Serial.begin(115200);
  while (!Serial && millis() < 3000);

  Serial.println("\n=== Lab 7: Integrated Environmental Data Logger (Part F) ===");

  Wire.begin(21, 22);

  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Lab 7 System");
  lcd.setCursor(0, 1);
  lcd.print("Booting Logger..");

  dht.begin();

  if (!bmpA.begin(BMP_A_ADDR)) {
    Serial.println("[WARN] BMP280 initialization failed!");
  } else {
    bmpA.setSampling(Adafruit_BMP280::MODE_NORMAL, Adafruit_BMP280::SAMPLING_X2, Adafruit_BMP280::SAMPLING_X16, Adafruit_BMP280::FILTER_X16, Adafruit_BMP280::STANDBY_MS_500);
  }

  if (!lightMeter.begin(BH1750::CONTINUOUS_HIGH_RES_MODE)) {
    Serial.println("[WARN] BH1750 initialization failed!");
  }

  // Initialize MicroSD Storage
  if (SD.begin(SD_CS_PIN)) {
    sdMounted = true;
    Serial.println("[OK] MicroSD card initialized successfully.");
    
    // Create CSV header if file doesn't exist
    if (!SD.exists(logFilename)) {
      File file = SD.open(logFilename, FILE_WRITE);
      if (file) {
        file.println("Timestamp_s,Temp_C,Hum_Pct,Pres_hPa,Lux,Flags");
        file.close();
        Serial.println("[OK] CSV log header created.");
      }
    }
  } else {
    Serial.println("[FAIL] MicroSD card mounting failed! Continuing without SD logging.");
  }

  delay(2000);
  lcd.clear();
}

void loop() {
  unsigned long now = millis();

  if (now - lastAcquireTime >= acquireInterval) {
    lastAcquireTime = now;

    // 1. Synchronized Data Acquisition
    EnvRecord record = acquireData();

    // 2. Serial Telemetry
    Serial.printf("[%lu s] Temp: %.1f C | Hum: %.1f %% | Pres: %.1f hPa | Light: %.1f lux | Flags: 0x%02X | SD: %s\n",
                  record.ts, record.tempC, record.humPct, record.presHpa, record.lux, record.flags, sdMounted ? "OK" : "ERR");

    // 3. Write record to microSD Card
    if (sdMounted) {
      logToSD(record);
    }

    // 4. Update LCD Display
    updateLCD(record);
  }
}

EnvRecord acquireData() {
  EnvRecord r;
  r.ts      = millis() / 1000;
  r.tempC   = dht.readTemperature();
  r.humPct  = dht.readHumidity();
  r.presHpa = bmpA.readPressure() / 100.0F; 
  r.lux     = lightMeter.readLightLevel();
  r.flags   = checkPlausibility(r);
  return r;
}

uint8_t checkPlausibility(const EnvRecord& r) {
  uint8_t f = 0x00;
  if (isnan(r.tempC) || r.tempC < -20.0 || r.tempC > 70.0) f |= 0x01;
  if (isnan(r.humPct) || r.humPct < 0.0 || r.humPct > 100.0) f |= 0x02;
  if (isnan(r.presHpa) || r.presHpa < 800.0 || r.presHpa > 1100.0) f |= 0x04;
  if (isnan(r.lux) || r.lux < 0.0 || r.lux > 100000.0) f |= 0x08;
  return f;
}

void logToSD(const EnvRecord& r) {
  File logFile = SD.open(logFilename, FILE_WRITE);
  if (logFile) {
    logFile.printf("%lu,%.1f,%.1f,%.1f,%.1f,0x%02X\n",
                    r.ts, r.tempC, r.humPct, r.presHpa, r.lux, r.flags);
    logFile.close();
  } else {
    Serial.println("[WARN] File write failed! SD card removed?");
    sdMounted = false;
  }
}

void updateLCD(const EnvRecord& r) {
  lcd.clear();

  if (r.flags != 0x00) {
    lcd.setCursor(0, 0);
    lcd.print("FLAG: 0x");
    if (r.flags < 0x10) lcd.print("0");
    lcd.print(r.flags, HEX);
    lcd.print(" ERR");

    lcd.setCursor(0, 1);
    lcd.print(sdMounted ? "SD: LOGGING" : "SD: NO CARD");
    return;
  }

  if (!toggleDisplay) {
    lcd.setCursor(0, 0);
    lcd.print("T:"); lcd.print(r.tempC, 1); lcd.print("C ");
    lcd.print("H:"); lcd.print((int)r.humPct); lcd.print("%");

    lcd.setCursor(0, 1);
    lcd.print("SD:");
    lcd.print(sdMounted ? "LOGGING OK" : "OFFLINE");
  } else {
    lcd.setCursor(0, 0);
    lcd.print("P:"); lcd.print(r.presHpa, 1); lcd.print("hPa");

    lcd.setCursor(0, 1);
    lcd.print("L:"); lcd.print(r.lux, 1); lcd.print("lx");
  }

  toggleDisplay = !toggleDisplay;
}
